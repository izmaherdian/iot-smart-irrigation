# Copy to .env and fill in your own values before running ./pasang.sh
MQTT_PORT=1884
MQTT_USER=change-me
MQTT_PASSWORD=change-me

# InfluxDB admin account (keep private)
INFLUX_USER=admin
INFLUX_PASSWORD=change-me-min-8-chars
INFLUX_ORG="SITH ITB"   # the flows use this organisation name
INFLUX_TOKEN=change-me-long-random-string
# main bucket (long retention) and draft bucket (short retention, for experiments)
INFLUX_BUCKET=BE4001
INFLUX_RETENTION=90d
INFLUX_BUCKET_DRAFT=BE4001_D
INFLUX_RETENTION_DRAFT=7d
# shared read/write web account for users; its token is created by siapkan_influx.sh
INFLUX_USER_PRAKTIKAN=user
INFLUX_PASSWORD_PRAKTIKAN=change-me-min-8-chars
